# Copy to .env (git-ignored) and fill in. Spring Boot does not read .env itself:
# export these in your shell or IDE run configuration (Docker Compose will use .env in Phase 10).

# Password for the "postgres" user on jdbc:postgresql://localhost:5432/saas_backend
DB_PASSWORD=

# HMAC key for signing JWTs. At least 32 bytes (256 bits), random, never committed.
# Example: openssl rand -base64 48
JWT_SECRET=
